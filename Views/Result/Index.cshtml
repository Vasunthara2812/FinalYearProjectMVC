@model List<LearningApp.Models.Result>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Results";
}

<link rel="stylesheet" href="~/css/results.css" />

<div class="main-content">

    <h2>Results</h2>

    <!-- Search Form -->
    <form id="searchForm" style="margin-bottom:20px;">
        <input type="text"
               id="searchInput"
               name="search"
               placeholder="Search by course ID"
               style="padding:10px; border-radius:5px; border:2px solid #e0e0e0; margin-right:10px; min-width:300px;" />

        <button type="submit"
                style="padding:10px 20px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; border:none; border-radius:5px; font-weight:600; cursor:pointer;">
            Search
        </button>
    </form>

    <!-- Search Result Message -->
    <div id="searchMessage"
         style="margin-bottom:15px; padding:10px; border-radius:5px; display:none;">
    </div>

    <!-- Table Container -->
    <div id="tableContainer">
        <table>
            <thead>
                <tr>
                    <th>Result Id</th>
                    <th>Course Id</th>
                    <th>Chapter Id</th>
                    <th>Subtopic Id</th>
                    <th>Result Text</th>
                </tr>
            </thead>

            <tbody id="tableBody">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var text = item.ResultText ?? "";
                        var shortText = text.Length > 250 ? text.Substring(0, 250) + "..." : text;

                        <tr data-course-id="@item.CourseId">
                            <td>@item.ResultId</td>
                            <td>@item.CourseId</td>
                            <td>@item.ChapterId</td>
                            <td>@item.SubtopicId</td>
                            <td>
                                <div class="result-content">

                                    <span class="short-text">
                                        @shortText
                                    </span>

                                    @if (text.Length > 250)
                                    {
                                        <span class="full-text" style="display:none;">
                                            @text
                                        </span>

                                        <a href="#"
                                           class="read-toggle"
                                           style="display:block; margin-top:6px; font-weight:600; color:#667eea;">
                                            Read More
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <div class="empty-state-icon">📊</div>
                                <div class="empty-state-text">No results found</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {

<script>

    // Highlight active navigation
    document.addEventListener('DOMContentLoaded', function () {
        const navLinks = document.querySelectorAll('.nav-link');
        navLinks.forEach(link => {
            if (link.textContent.trim() === 'Learning') {
                link.classList.add('active');
            }
        });
    });


    // =============================
    // SEARCH FUNCTION (SubtopicId)
    // =============================
    document.getElementById("searchForm").addEventListener("submit", function (e) {

        e.preventDefault();

        const searchValue = document.getElementById("searchInput").value.trim();
        const searchMessage = document.getElementById("searchMessage");

        searchMessage.style.display = "none";
        searchMessage.textContent = "";

        if (!searchValue) {
            searchMessage.style.display = "block";
            searchMessage.style.background = "#fff3cd";
            searchMessage.style.color = "#856404";
            searchMessage.style.border = "1px solid #ffeaa7";
            searchMessage.textContent = "⚠️ Please enter a Subtopic ID to search";
            return;
        }

        const allRows = document.querySelectorAll("#tableBody tr");
        let matchCount = 0;

        allRows.forEach(row => {

            const subtopicId = row.getAttribute("data-subtopic-id");

            if (!subtopicId) {
                row.style.display = "none";
                return;
            }

            if (subtopicId.includes(searchValue)) {
                matchCount++;
                row.style.display = "";
                row.style.background = "#e8f4f8";
            } else {
                row.style.display = "none";
                row.style.background = "";
            }

        });

        if (matchCount === 0) {
            searchMessage.style.display = "block";
            searchMessage.style.background = "#f8d7da";
            searchMessage.style.color = "#721c24";
            searchMessage.style.border = "1px solid #f5c6cb";
            searchMessage.textContent = "❌ No results found with that Subtopic ID";
        }
        else if (matchCount === 1) {
            searchMessage.style.display = "block";
            searchMessage.style.background = "#d4edda";
            searchMessage.style.color = "#155724";
            searchMessage.style.border = "1px solid #c3e6cb";
            searchMessage.textContent = "✓ Found 1 result matching your search";
        }
        else {
            searchMessage.style.display = "block";
            searchMessage.style.background = "#d1ecf1";
            searchMessage.style.color = "#0c5460";
            searchMessage.style.border = "1px solid #bee5eb";
            searchMessage.textContent = `ℹ️ Found ${matchCount} results matching your search`;
        }

    });



    // Clear search if input empty
    document.getElementById("searchInput").addEventListener("input", function () {

        if (this.value.trim() === "") {

            const allRows = document.querySelectorAll("#tableBody tr");

            allRows.forEach(row => {
                row.style.display = "";
                row.style.background = "";
            });

            document.getElementById("searchMessage").style.display = "none";
        }

    });


    // =============================
    // READ MORE / READ LESS
    // =============================
    document.addEventListener("click", function (e) {

        if (e.target.classList.contains("read-toggle")) {

            e.preventDefault();

            const container = e.target.closest(".result-content");
            const shortText = container.querySelector(".short-text");
            const fullText = container.querySelector(".full-text");

            if (fullText.style.display === "none") {
                shortText.style.display = "none";
                fullText.style.display = "inline";
                e.target.textContent = "Read Less";
            } else {
                shortText.style.display = "inline";
                fullText.style.display = "none";
                e.target.textContent = "Read More";
            }
        }

    });

</script>

}
