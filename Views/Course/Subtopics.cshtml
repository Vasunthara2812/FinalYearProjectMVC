}

.navigation-controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

@@media (max-width: 768px) {
    .chapter-header {
        flex-direction: column;
    }

    .subtopic-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .subtopic-meta {
        width: 100%;
        margin-top: 10px;
    }

    .content-area {
        max-height: none;
    }

    .content-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        text-align: center;
    }
}
</style>
