}

.expand-btn {
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0;
    color: #667eea;
    transition: transform 0.3s ease;
    margin-top: 3px;
}

.expand-btn:hover {
    transform: scale(1.2);
}

.expand-icon {
    display: inline-block;
    transition: transform 0.3s ease;
}

.subtopic-info h3 {
