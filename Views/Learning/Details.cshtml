@model List<LearningApp.Models.TrainingRequirement>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Training Requirements - Learning App</title>
    <link rel="stylesheet" href="~/css/training-details-layout.css" />
    <style>
        .btn-add-requirement {
            display: inline-block;
            padding: 10px 20px;
            background-color: #2196F3;
            color: white;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: background-color 0.2s;
        }
        .btn-add-requirement:hover {
            background-color: #1565c0;
            color: white;
        }
    </style>
</head>
<body>

    <div class="main-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2>📚 Training Requirements</h2>
            <a asp-controller="Learning" asp-action="Index" class="btn-add-requirement">
                + Add Requirement
            </a>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon purple">
                        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@Model.Count</div>
                        <div class="stat-label">Total Requirements</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">
                        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@Model.Count(r => r.CourseId.HasValue)</div>
                        <div class="stat-label">Courses Generated</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon orange">
                        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@Model.Count(r => !r.CourseId.HasValue)</div>
                        <div class="stat-label">Pending Generation</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon blue">
                        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@Model.Select(r => r.Domain).Distinct().Count()</div>
                        <div class="stat-label">Unique Domains</div>
                    </div>
                </div>
            </div>

            <!-- Requirements Table -->
            <div id="tableContainer">
                <table>
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Domain</th>
                            <th>Interest</th>
                            <th>Skill Level</th>
                            <th>Goal</th>
                            <th>Generated Course</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="role-cell">
                                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                            <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z"/>
                                        </svg>
                                        <strong>@item.Role</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="domain-tag">@item.Domain</span>
                                </td>
                                <td>@item.Interest</td>
                                <td>
                                    <span class="skill-badge skill-@(item.SkillLevel?.ToLower() ?? "unknown")">
                                        @if (item.SkillLevel == "Beginner")
                                        {
                                            <text>🌱 </text>
                                        }
                                        else if (item.SkillLevel == "Intermediate")
                                        {
                                            <text>📈 </text>
                                        }
                                        else if (item.SkillLevel == "Advanced")
                                        {
                                            <text>🚀 </text>
                                        }
                                        @item.SkillLevel
                                    </span>
                                </td>
                                <td>@item.Goal</td>
                                <td>
                                    @if (item.CourseGenerated)
                                    {
                                        <div class="course-cell">
                                            <div class="course-info">
                                                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="color: #28a745; flex-shrink: 0;">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                                </svg>
                                                <div>
                                                    <div class="course-name">✅ Course Generated</div>
                                                    <div class="course-id">@item.CourseName</div>
                                                </div>
                                            </div>

                                            @if (item.CourseId.HasValue)
                                            {
                                                <a href="/chapter/index/@item.CourseId" class="btn-view-small">View</a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pending-cell">
                                            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                            </svg>
                                            ⏳ Pending Generation...
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div id="tableContainer">
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg width="56" height="56" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
                        </svg>
                    </div>
                    <h3>No Training Requirements Yet</h3>
                    <p>Start your learning journey by creating your first training requirement</p>
                    <a asp-controller="Learning" asp-action="Index" class="btn-primary">
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
                        </svg>
                        Create First Requirement
                    </a>
                </div>
            </div>
        }
    </div>

</body>
</html>