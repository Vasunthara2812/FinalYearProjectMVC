<h2>Training Requirements</h2>

<form method="post">
    
    <label>Role</label><br />
    <input type="text" name="role" /><br /><br />
    <label>Domain</label><br />
    <input type="text" name="domain" /><br /><br />
    <label>Interest</label><br />
    <input type="text" name="interest" /><br /><br />
    <label>Skill Level</label><br />
    <input type="text" name="skillLevel" /><br /><br />
    <label>Goal</label><br />
    <input type="text" name="goal" /><br /><br />
    

    <button type="submit">Submit</button>
</form>

<p style="color:red">@ViewBag.Error</p>
<p style="color:green">@ViewBag.Success</p>
