@model List<FinalYearProjectMVC.Models.RequirementViewModel>
@{
    ViewData["Title"] = "Requirements";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 fw-bold text-dark">
            <i class="bi bi-list-check me-2 text-primary"></i>Requirements
        </h2>
        <p class="text-muted mb-0">Manage and track course generation for all requirements</p>
    </div>
    <a asp-controller="Requirements" asp-action="Create" class="btn btn-primary px-4">
        <i class="bi bi-plus-lg me-1"></i> New Requirement
    </a>
</div>

<!-- Summary Cards -->
@{
    int total     = Model.Count;
    int generated = Model.Count(r => r.CourseGenerated);
    int pending   = total - generated;
}
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon-box bg-primary-subtle rounded-3 p-3">
                    <i class="bi bi-clipboard-data fs-4 text-primary"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-dark lh-1">@total</div>
                    <div class="text-muted small">Total Requirements</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon-box bg-success-subtle rounded-3 p-3">
                    <i class="bi bi-check-circle fs-4 text-success"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-dark lh-1">@generated</div>
                    <div class="text-muted small">Courses Generated</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon-box bg-warning-subtle rounded-3 p-3">
                    <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-dark lh-1">@pending</div>
                    <div class="text-muted small">Pending Generation</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <span class="fw-semibold text-dark">All Requirements</span>
        <!-- Search -->
        <div class="input-group" style="max-width:280px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" id="tableSearch" class="form-control border-start-0 ps-0"
                   placeholder="Search requirements…">
        </div>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No requirements found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="requirementsTable">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Role</th>
                            <th>Domain</th>
                            <th>Interest</th>
                            <th>Skill Level</th>
                            <th>Goal</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@req.RequirementId</td>
                                <td>
                                    <span class="fw-semibold text-dark">@req.Role</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">
                                        @req.Domain
                                    </span>
                                </td>
                                <td class="text-muted" style="max-width:180px;">
                                    <span class="text-truncate d-inline-block" style="max-width:170px;"
                                          title="@req.Interest">@req.Interest</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(req.SkillLevel))
                                    {
                                        var (badgeClass, icon) = req.SkillLevel.ToLower() switch
                                        {
                                            "beginner"     => ("bg-info-subtle text-info",       "bi-star"),
                                            "intermediate" => ("bg-warning-subtle text-warning", "bi-star-half"),
                                            "advanced"     => ("bg-danger-subtle text-danger",   "bi-star-fill"),
                                            _              => ("bg-secondary-subtle text-secondary", "bi-star")
                                        };
                                        <span class="badge @badgeClass rounded-pill px-3">
                                            <i class="bi @icon me-1"></i>@req.SkillLevel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-muted small" style="max-width:200px;">
                                    <span class="text-truncate d-inline-block" style="max-width:190px;"
                                          title="@req.Goal">@(req.Goal ?? "—")</span>
                                </td>
                                <td class="text-center">
                                    @if (req.CourseGenerated)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                            <i class="bi bi-check-circle me-1"></i>Generated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    @if (req.CourseGenerated && req.CourseId.HasValue)
                                    {
                                        <a href="http://localhost:5115/content/index/@req.CourseId"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-play-circle me-1"></i>View Course
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Pending generation</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="card-footer bg-white border-top py-2 text-muted small text-end pe-4">
        Showing <span id="visibleCount">@Model.Count</span> of @Model.Count requirements
    </div>
</div>

@section Scripts {
<script>
    // Live search
    const searchInput = document.getElementById('tableSearch');
    const tableBody   = document.querySelector('#requirementsTable tbody');
    const visibleCount = document.getElementById('visibleCount');

    searchInput?.addEventListener('input', function () {
        const term = this.value.toLowerCase();
        let count  = 0;
        tableBody.querySelectorAll('tr').forEach(row => {
            const match = row.textContent.toLowerCase().includes(term);
            row.style.display = match ? '' : 'none';
            if (match) count++;
        });
        visibleCount.textContent = count;
    });
</script>
}
